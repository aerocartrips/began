{
  "name": "norosilk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:scale": "vitest run --mode scale tests/integration/homepage-scale.integration.test.js",
    "seed:catalog": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-alias.mjs scripts/seed-storefront-catalog.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "import:legacy-contacts": "node --env-file-if-exists=.env scripts/import-legacy-contact-messages.mjs",
    "tenant:create": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-alias.mjs scripts/create-tenant.mjs",
    "tenant:migrate": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-alias.mjs scripts/migrate-to-multi-tenant.mjs",
    "tenant:integrations": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-alias.mjs scripts/set-tenant-integrations.mjs",
    "admin:create": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-alias.mjs scripts/create-admin-user.mjs",
    "seed:test": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-alias.mjs scripts/seed-test-data.mjs",
    "seed:test-banners": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-alias.mjs scripts/seed-test-banners.mjs"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "mongoose": "^9.11.4",
    "next": "16.4.2",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}

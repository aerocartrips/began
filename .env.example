# Dashboard admin bootstrap. Prefer a database admin (scripts/create-admin-user.mjs).
# ADMIN_PASSWORD works only outside production; production needs ADMIN_PASSWORD_HASH
# (bcrypt, cost >= 12 — generate with scripts/hash-admin-password.mjs).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_HOURS=

# MongoDB Atlas connection string
MONGODB_URI=
MONGODB_URI_TEST=

# JWT auth for /api/v1 (minimum 32 bytes each, and different from each other)
JWT_SECRET=
JWT_REFRESH_SECRET=

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional wholesale order pricing rules
TAX_RATE_PERCENT=0
SHIPPING_FLAT_AMOUNT=0
SHIPPING_FREE_THRESHOLD=0

# Admin overview flags active products at or below this stock level
LOW_STOCK_THRESHOLD=5

# Cloudinary (optional image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Razorpay (Test or Live keys via environment)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
CHECKOUT_CURRENCY=INR
PAYMENT_RESERVATION_MINUTES=30

# Delhivery tracking (optional)
DELHIVERY_API_TOKEN=
DELHIVERY_API_BASE_URL=https://track.delhivery.com
DELHIVERY_TRACKING_CACHE_MS=300000

# Delhivery B2B/LTL booking (set paths from official Delhivery B2B documentation)
DELHIVERY_B2B_UMS_LOGIN_URL=https://ltl-clients-api.delhivery.com/ums/login
DELHIVERY_B2B_API_BASE_URL=https://btob.api.delhivery.com
DELHIVERY_B2B_USERNAME=
DELHIVERY_B2B_PASSWORD=
DELHIVERY_B2B_BOOKING_PATH=
DELHIVERY_B2B_MANIFEST_PATH=

# Secured cron for background jobs (Bearer token)
CRON_SECRET=
CLOUDINARY_UPLOAD_FOLDER=norosilk/products
UPLOAD_MAX_BYTES=5242880

# Transactional email (optional, Resend)
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Norosilk <orders@yourdomain.com>
RESEND_API_KEY=

# Customer support chat polling (optional, milliseconds)
NEXT_PUBLIC_SUPPORT_POLL_INTERVAL_MS=8000
NEXT_PUBLIC_SUPPORT_LIST_POLL_INTERVAL_MS=30000

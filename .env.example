# ---------------------------------------------------------------------------
# Platform configuration. Everything store-specific (name, domains, branding,
# sales mode, contact, GST, tax/shipping, Razorpay and Delhivery credentials,
# admin accounts) lives in the database per store; see README → "Stores".
# ---------------------------------------------------------------------------

NODE_ENV=development

# MongoDB (required). MONGODB_URI_TEST is used by the opt-in integration tests.
MONGODB_URI=
MONGODB_URI_TEST=

# Secrets: 32+ random bytes each, all different. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Encrypts each store's integration credentials at rest. Exactly 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored credentials unreadable; re-enter them with npm run tenant:integrations.
TENANT_SECRETS_KEY=

# Bearer token for /api/cron/* (16+ characters). Each job runs once per active store.
CRON_SECRET=

# Cloudinary image uploads (optional; shared account, one folder per store).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Transactional email via Resend (optional). Emails go out as "<Store name> <address>";
# each store's alert inbox is set in Admin → Store settings → Business & GST.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=orders@yourdomain.com
# Opt-in: also email customers for key order/shipping updates (honours their email preferences).
CUSTOMER_NOTIFICATION_EMAILS=false

# Delhivery API endpoints (credentials are per store). Booking paths come from Delhivery's B2B docs.
DELHIVERY_API_BASE_URL=https://track.delhivery.com
DELHIVERY_TRACKING_CACHE_MS=300000
DELHIVERY_B2B_UMS_LOGIN_URL=https://ltl-clients-api.delhivery.com/ums/login
DELHIVERY_B2B_API_BASE_URL=https://btob.api.delhivery.com
DELHIVERY_B2B_BOOKING_PATH=
DELHIVERY_B2B_MANIFEST_PATH=

# Polling intervals (ms) and notification housekeeping.
NEXT_PUBLIC_SUPPORT_POLL_INTERVAL_MS=8000
NEXT_PUBLIC_SUPPORT_LIST_POLL_INTERVAL_MS=30000
NEXT_PUBLIC_NOTIFICATION_POLL_INTERVAL_MS=30000
NOTIFICATION_RETENTION_DAYS=180
SUPPORT_UNANSWERED_ALERT_HOURS=12
